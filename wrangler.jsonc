{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-local-llm",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "assets": {
    "directory": "./static"
  },
  "routes": [
    {
      "pattern": "image-local-llm.xiaosang.cc",
      "custom_domain": true
    }
  ]
}
